{
  "name": "UnreportedIW",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "SourceFolder",
        "kind": "m",
        "expression": "\"\\\\cscso1fsappv01\\data\\HTOC\\Data_Analytics\\Data\\Threat Assessment Scores\\ThreatAssessI_W\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "LatestFile",
        "kind": "m",
        "expression": "let\n    Files = Folder.Contents(SourceFolder),\n    Candidates = Table.SelectRows(Files, each\n        let n = [Name], d = Text.Middle(n, 16, 8)\n        in Text.Length(n) = 29 and Text.Start(n, 16) = \"ThreatAssessI_W_\"\n            and Text.End(n, 5) = \".xlsx\" and Text.Select(d, {\"0\"..\"9\"}) = d\n            and [Attributes]?[Hidden]? <> true),\n    Dated = Table.AddColumn(Candidates, \"Snapshot Date\", each\n        let d = Text.Middle([Name],16,8)\n        in try #date(Number.FromText(Text.Start(d,4)),Number.FromText(Text.Middle(d,4,2)),Number.FromText(Text.End(d,2))) otherwise null, type date),\n    Valid = Table.SelectRows(Dated, each [Snapshot Date] <> null),\n    Sorted = Table.Sort(Valid, {{\"Snapshot Date\", Order.Descending}, {\"Name\", Order.Descending}}),\n    Latest = if Table.IsEmpty(Sorted) then error \"No valid ThreatAssessI_W_YYYYMMDD.xlsx snapshot found in SourceFolder.\" else Sorted{0}\nin Latest"
      },
      {
        "name": "UnreportedSnapshot",
        "kind": "m",
        "expression": "let\n    Workbook = Excel.Workbook(LatestFile[Content], null, true),\n    NoSheets = Table.SelectRows(Workbook, each [Kind] = \"Sheet\" and Text.Lower(Text.Trim([Item])) = \"i&w_no\"),\n    Raw = if Table.RowCount(NoSheets) <> 1 then error \"Latest workbook must contain exactly one I&W_No worksheet. No fallback to a prior snapshot or reported worksheet is allowed.\" else NoSheets{0}[Data],\n    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),\n    Checked = if not Table.HasColumns(Headers, {\"Indicator\", \"PRISM Score\", \"Severity\"}) then error \"I&W_No is missing required Indicator, PRISM Score, or Severity headers.\" else Headers,\n    WithStatus = if Table.HasColumns(Checked, \"Reported I&W?\") then Checked else Table.AddColumn(Checked, \"Reported I&W?\", each \"No\", type text),\n    Unreported = Table.SelectRows(WithStatus, each\n        let v = Record.Field(_, \"Reported I&W?\"), s = if v = null then \"\" else Text.Lower(Text.Trim(Text.From(v)))\n        in List.Contains({\"\", \"no\", \"n\", \"false\", \"0\", \"unreported\", \"not reported\"}, s)),\n    Nonblank = Table.SelectRows(Unreported, each [Indicator] <> null and Text.Trim(Text.From([Indicator])) <> \"\"),\n    Selected = Table.SelectColumns(Nonblank, [\"Indicator\", \"Host IP\", \"Last Observed\", \"Indicator Type\", \"VirusTotal Malicious Score\", \"GTI Verdict\", \"GTI Threat Score\", \"GTI Severity\", \"Mandiant\", \"Observation Yearly Count\", \"ThreatConnect Rating\", \"Observation Penalty Multiplier\", \"Botnet Flag\", \"False Positives\", \"Partners\", \"incidents/events\", \"Threat Actor\", \"Tagging Boost\", \"Tagging Boost Reason\", \"CAL Score\", \"ThreatConnect Score\", \"PRISM Score\", \"Severity\", \"Explanation\", \"Associated Groups\", \"Tags\", \"OpDiv\"], MissingField.UseNull),\n    Numbers = Table.TransformColumns(Selected, {{\"VirusTotal Malicious Score\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"GTI Threat Score\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"Mandiant\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"Observation Yearly Count\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"ThreatConnect Rating\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"Observation Penalty Multiplier\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"Botnet Flag\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"False Positives\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"Tagging Boost\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"CAL Score\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"ThreatConnect Score\", each if _ = null then null else Number.From(_, \"en-US\"), type number},\n        {\"PRISM Score\", each if _ = null then null else Number.From(_, \"en-US\"), type number}}),\n    Texts = Table.TransformColumns(Numbers, {{\"Indicator\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"Host IP\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"Indicator Type\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"GTI Verdict\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"GTI Severity\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"Partners\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"incidents/events\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"Threat Actor\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"Tagging Boost Reason\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"Severity\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"Explanation\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"Associated Groups\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"Tags\", each if _ = null then null else Text.From(_, \"en-US\"), type text},\n        {\"OpDiv\", each if _ = null then null else Text.From(_, \"en-US\"), type text}}),\n    Dates = Table.TransformColumns(Texts, {{\"Last Observed\", each if _ = null or _ = \"\" then null else DateTime.From(_, \"en-US\"), type datetime}}),\n    Severity = Table.TransformColumns(Dates, {{\"Severity\", each if _ = null or Text.Trim(_) = \"\" then \"Unknown\" else Text.Proper(Text.Trim(_)), type text}}),\n    Rank = Table.AddColumn(Severity, \"Severity Rank\", each if [Severity] = \"Critical\" then 1 else if [Severity] = \"High\" then 2 else if [Severity] = \"Medium\" then 3 else if [Severity] = \"Low\" then 4 else if [Severity] = \"Informational\" then 5 else 6, Int64.Type),\n    Status = Table.AddColumn(Rank, \"Reported I&W?\", each \"No\", type text),\n    Snapshot = Table.AddColumn(Status, \"Snapshot Date\", each LatestFile[Snapshot Date], type date),\n    File = Table.AddColumn(Snapshot, \"Source File\", each LatestFile[Name], type text)\nin File"
      }
    ],
    "tables": [
      {
        "name": "Unreported I&W",
        "columns": [
          {
            "name": "Indicator",
            "dataType": "string",
            "sourceColumn": "Indicator",
            "summarizeBy": "none"
          },
          {
            "name": "Host IP",
            "dataType": "string",
            "sourceColumn": "Host IP",
            "summarizeBy": "none"
          },
          {
            "name": "Last Observed",
            "dataType": "dateTime",
            "sourceColumn": "Last Observed",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd HH:mm"
          },
          {
            "name": "Indicator Type",
            "dataType": "string",
            "sourceColumn": "Indicator Type",
            "summarizeBy": "none"
          },
          {
            "name": "VirusTotal Malicious Score",
            "dataType": "double",
            "sourceColumn": "VirusTotal Malicious Score",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "GTI Verdict",
            "dataType": "string",
            "sourceColumn": "GTI Verdict",
            "summarizeBy": "none"
          },
          {
            "name": "GTI Threat Score",
            "dataType": "double",
            "sourceColumn": "GTI Threat Score",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "GTI Severity",
            "dataType": "string",
            "sourceColumn": "GTI Severity",
            "summarizeBy": "none"
          },
          {
            "name": "Mandiant",
            "dataType": "double",
            "sourceColumn": "Mandiant",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "Observation Yearly Count",
            "dataType": "double",
            "sourceColumn": "Observation Yearly Count",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "ThreatConnect Rating",
            "dataType": "double",
            "sourceColumn": "ThreatConnect Rating",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "Observation Penalty Multiplier",
            "dataType": "double",
            "sourceColumn": "Observation Penalty Multiplier",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "Botnet Flag",
            "dataType": "double",
            "sourceColumn": "Botnet Flag",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "False Positives",
            "dataType": "double",
            "sourceColumn": "False Positives",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "Partners",
            "dataType": "string",
            "sourceColumn": "Partners",
            "summarizeBy": "none"
          },
          {
            "name": "incidents/events",
            "dataType": "string",
            "sourceColumn": "incidents/events",
            "summarizeBy": "none"
          },
          {
            "name": "Threat Actor",
            "dataType": "string",
            "sourceColumn": "Threat Actor",
            "summarizeBy": "none"
          },
          {
            "name": "Tagging Boost",
            "dataType": "double",
            "sourceColumn": "Tagging Boost",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "Tagging Boost Reason",
            "dataType": "string",
            "sourceColumn": "Tagging Boost Reason",
            "summarizeBy": "none"
          },
          {
            "name": "CAL Score",
            "dataType": "double",
            "sourceColumn": "CAL Score",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "ThreatConnect Score",
            "dataType": "double",
            "sourceColumn": "ThreatConnect Score",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "PRISM Score",
            "dataType": "double",
            "sourceColumn": "PRISM Score",
            "summarizeBy": "none",
            "formatString": "#,0.0"
          },
          {
            "name": "Severity",
            "dataType": "string",
            "sourceColumn": "Severity",
            "summarizeBy": "none",
            "sortByColumn": "Severity Rank"
          },
          {
            "name": "Explanation",
            "dataType": "string",
            "sourceColumn": "Explanation",
            "summarizeBy": "none"
          },
          {
            "name": "Associated Groups",
            "dataType": "string",
            "sourceColumn": "Associated Groups",
            "summarizeBy": "none"
          },
          {
            "name": "Tags",
            "dataType": "string",
            "sourceColumn": "Tags",
            "summarizeBy": "none"
          },
          {
            "name": "OpDiv",
            "dataType": "string",
            "sourceColumn": "OpDiv",
            "summarizeBy": "none"
          },
          {
            "name": "Severity Rank",
            "dataType": "int64",
            "sourceColumn": "Severity Rank",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Reported I&W?",
            "dataType": "string",
            "sourceColumn": "Reported I&W?",
            "summarizeBy": "none"
          },
          {
            "name": "Snapshot Date",
            "dataType": "dateTime",
            "sourceColumn": "Snapshot Date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Source File",
            "dataType": "string",
            "sourceColumn": "Source File",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Unreported Indicators",
            "expression": "COALESCE(DISTINCTCOUNT('Unreported I&W'[Indicator]), 0)",
            "formatString": "#,0",
            "displayFolder": "Unreported I&W"
          },
          {
            "name": "High or Critical",
            "expression": "COALESCE(CALCULATE([Unreported Indicators], KEEPFILTERS('Unreported I&W'[Severity] IN {\"High\", \"Critical\"})), 0)",
            "formatString": "#,0",
            "displayFolder": "Unreported I&W"
          },
          {
            "name": "Average PRISM",
            "expression": "AVERAGE('Unreported I&W'[PRISM Score])",
            "formatString": "#,0.0",
            "displayFolder": "Unreported I&W"
          },
          {
            "name": "Highest PRISM",
            "expression": "MAX('Unreported I&W'[PRISM Score])",
            "formatString": "#,0",
            "displayFolder": "Unreported I&W"
          },
          {
            "name": "Unreported Records",
            "expression": "COUNTROWS('Unreported I&W')",
            "formatString": "#,0",
            "displayFolder": "Unreported I&W"
          },
          {
            "name": "Average VT Malicious",
            "expression": "AVERAGE('Unreported I&W'[VirusTotal Malicious Score])",
            "formatString": "#,0.0",
            "displayFolder": "Unreported I&W"
          }
        ],
        "partitions": [
          {
            "name": "Latest unreported snapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = UnreportedSnapshot in Source"
            }
          }
        ]
      },
      {
        "name": "Snapshot",
        "columns": [
          {
            "name": "Snapshot Date",
            "dataType": "dateTime",
            "sourceColumn": "Snapshot Date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Source File",
            "dataType": "string",
            "sourceColumn": "Source File",
            "summarizeBy": "none"
          },
          {
            "name": "File Modified",
            "dataType": "dateTime",
            "sourceColumn": "File Modified",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd HH:mm"
          },
          {
            "name": "Refreshed At",
            "dataType": "dateTime",
            "sourceColumn": "Refreshed At",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd HH:mm"
          },
          {
            "name": "Unreported Rows",
            "dataType": "int64",
            "sourceColumn": "Unreported Rows",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Snapshot As Of",
            "expression": "MAX('Snapshot'[Snapshot Date])",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "Source Modified",
            "expression": "MAX('Snapshot'[File Modified])",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "Last Refresh",
            "expression": "MAX('Snapshot'[Refreshed At])",
            "formatString": "dd MMM yyyy HH:mm"
          }
        ],
        "partitions": [
          {
            "name": "Snapshot metadata",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Result = #table({\"Snapshot Date\", \"Source File\", \"File Modified\", \"Refreshed At\", \"Unreported Rows\"}, {{LatestFile[Snapshot Date], LatestFile[Name], LatestFile[Date modified], DateTime.LocalNow(), Table.RowCount(UnreportedSnapshot)}}),\n    Typed = Table.TransformColumnTypes(Result, {{\"Snapshot Date\", type date}, {\"Source File\", type text}, {\"File Modified\", type datetime}, {\"Refreshed At\", type datetime}, {\"Unreported Rows\", Int64.Type}})\nin Typed"
            }
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"SourceFolder\", \"LatestFile\", \"UnreportedSnapshot\", \"Unreported I&W\", \"Snapshot\"]"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ]
  }
}
