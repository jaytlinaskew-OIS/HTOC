{
  "groupXid": "GTIDepr1",
  "name": "GTI Indicator Deprecation",
  "type": "Playbook",
  "panX": -50.0,
  "panY": 80.0,
  "zoom": 0.75,
  "logLevel": "INFO",
  "description": "Deactivates only active HTOC Org indicators tagged GTI Indicator PB. Never-observed indicators age out after 30 days; observed indicators age out 90 days after lastObserved. GTI Retain is a manual exemption. Records are deactivated, not deleted. Maximum 1,000 candidates per execution.",
  "roiDollarsPerHour": 0.0,
  "roiMinutes": 0,
  "priority": 3,
  "version": "1.0",
  "comment": "Built from known-good target-instance exports. WebHook for controlled testing; production Timer remains disabled until validation.",
  "jobList": [
    {
      "id": 8900000000000010,
      "appCatalogItem": {
        "id": 730,
        "programName": "TCPB - Threatconnect Get Indicators v1",
        "displayName": "ThreatConnect Get Indicators",
        "programVersion": "1.0.9"
      },
      "name": "Get GTI-managed indicators eligible for deactivation",
      "jobParameterList": [
        {
          "appCatalogItemParameter": {
            "paramName": "indicator_id"
          }
        },
        {
          "appCatalogItemParameter": {
            "paramName": "entities"
          }
        },
        {
          "appCatalogItemParameter": {
            "paramName": "summary"
          }
        },
        {
          "appCatalogItemParameter": {
            "paramName": "indicator_type"
          }
        },
        {
          "appCatalogItemParameter": {
            "paramName": "tags"
          }
        },
        {
          "appCatalogItemParameter": {
            "paramName": "summaries"
          }
        },
        {
          "appCatalogItemParameter": {
            "paramName": "entity"
          }
        },
        {
          "appCatalogItemParameter": {
            "paramName": "fail_on_no_results"
          },
          "value": "false"
        },
        {
          "appCatalogItemParameter": {
            "paramName": "indicator_ids"
          }
        },
        {
          "appCatalogItemParameter": {
            "paramName": "max_results"
          },
          "value": "1000"
        },
        {
          "appCatalogItemParameter": {
            "paramName": "tc_action"
          },
          "value": "TQL"
        },
        {
          "appCatalogItemParameter": {
            "paramName": "tql"
          },
          "value": "ownerName in (\"HTOC Org\") and hasTag(summary in (\"GTI Indicator PB\")) and NOT hasTag(summary in (\"GTI Retain\")) and indicatorActive = true and (((observationCount = 0) and (dateAdded <= \"NOW() - 30 DAYS\")) or ((observationCount > 0) and (lastObserved <= \"NOW() - 90 DAYS\")))"
        },
        {
          "appCatalogItemParameter": {
            "paramName": "owner"
          }
        }
      ],
      "locationLeft": 300.0,
      "locationTop": 100.0,
