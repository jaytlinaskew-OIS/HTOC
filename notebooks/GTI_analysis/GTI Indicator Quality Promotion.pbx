  "logLevel": "INFO",
  "description": "Query the previous 24 hours of Google Threat Intelligence indicators, enforce the GTI quality rules, and create only passing indicators in HTOC Org. Includes a WebHook test trigger; the daily timer is disabled on import. No credentials embedded.",
  "roiDollarsPerHour": 0.0,
  "roiMinutes": 0,
  "priority": 3,
  "version": "1.4",
  "comment": "Added a WebHook trigger for testing. The daily timer remains disabled. Generated from GTI_indicator_quality_rules.md; validate once before enabling the timer.",
