      },
      "name": "Extract fields and deterministic checks",
      "jobParameterList": [
        {
          "appCatalogItemParameter": {
            "paramName": "string_expressions"
          },
          "value": "[{\"key\":\"indicator_id\",\"value\":\"to_string(id)\"},{\"key\":\"indicator_type\",\"value\":\"type\"},{\"key\":\"summary\",\"value\":\"summary\"},{\"key\":\"type_summary\",\"value\":\"join(`|`, [type, summary])\"},{\"key\":\"date_added\",\"value\":\"dateAdded\"},{\"key\":\"owner_name\",\"value\":\"ownerName\"},{\"key\":\"source_url\",\"value\":\"source\"},{\"key\":\"rating\",\"value\":\"to_string(rating)\"},{\"key\":\"confidence\",\"value\":\"to_string(confidence)\"},{\"key\":\"threat_rating\",\"value\":\"to_string(not_null(threatAssessRating, threatAssess.threatAssessRating))\"},{\"key\":\"threat_confidence\",\"value\":\"to_string(not_null(threatAssessConfidence, threatAssess.threatAssessConfidence))\"},{\"key\":\"description\",\"value\":\"not_null(attributes.data[?type == `Description`].value | [0], ``)\"},{\"key\":\"tags_joined\",\"value\":\"join(`\\\\n`, not_null(tags.data[].name, `[]`))\"},{\"key\":\"groups_joined\",\"value\":\"join(`; `, not_null(associatedGroups.data[].name, `[]`))\"},{\"key\":\"qualified_group_count\",\"value\":\"to_string(length(not_null(associatedGroups.data[?contains(`[\\\"Malware\\\",\\\"Campaign\\\",\\\"Intrusion Set\\\",\\\"Report\\\"]`, type) && id != null && name != null], `[]`)))\"},{\"key\":\"threat_assess_pass\",\"value\":\"to_string((not_null(threatAssessRating, threatAssess.threatAssessRating) >= `3`) && (not_null(threatAssessConfidence, threatAssess.threatAssessConfidence) >= `50`))\"},{\"key\":\"source_pass\",\"value\":\"to_string((type == `Address` && starts_with(source, `https://www.virustotal.com/gui/ip-address/`)) || (type == `Host` && starts_with(source, `https://www.virustotal.com/gui/domain/`)) || (type == `URL` && starts_with(source, `https://www.virustotal.com/gui/url/`)))\"},{\"key\":\"provenance_pass\",\"value\":\"to_string(privateFlag == `false` && id != null && type != null && summary != null && dateAdded != null && ownerName != null && source != null && rating != null && confidence != null && length(not_null(attributes.data[?type == `Description`].value | [0], ``)) > `0`)\"}]"
        },
        {
          "appCatalogItemParameter": {
            "paramName": "json_data"
